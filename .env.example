# Redis Connection URL (e.g. Upstash Redis, Redis Cloud, DragonFly, or self-hosted Redis)
# Format: redis://[username]:[password]@[host]:[port] or rediss://...
REDIS_URL="redis://127.0.0.1:6379"

# Secret key for anti-bot / link preview guard cookies (32+ random characters)
PASTE_JWT_SECRET="your-32-char-random-jwt-secret-key-goes-here"
